from datetime import datetime

class Book:
    def __init__(self, title, author, pages, year):
        self._title = title
        self._author = author
        self._pages = pages
        self._year = year

    
    def get_title(self):
        return self._title
    def set_title(self, title):
        self._title = title

    def get_author(self):
        return self._author
    def set_author(self, author):
        self._author = author

    def get_pages(self):
        return self._pages
    def set_pages(self, pages):
        self._pages = pages

    def get_year(self):
        return self._year
    def set_year(self, year):
        self._year = year

    def get_age(self):
        return datetime.now().year - self._year

    def is_old(self):
        return self.get_age() > 20

    def count_pages_per_year(self):
        age = self.get_age()
        return self._pages / age if age > 0 else self._pages

    def get_edition_info(self):
        return "Книга '{self._title}' издана в {self._year} году."

    def __str__(self):
        return "Book: '{self._title}' by {self._author} ({self._pages} страниц, {self._year})"

    def __lt__(self, other):
        return self._year < other._year

    def __add__(self, other):
        return self._pages + other._pages

    def __len__(self):
        return self._pages


class Textbook(Book):
    def __init__(self, title, author, pages, year, subject):
        super().__init__(title, author, pages, year)
        self._subject = subject

    def get_subject(self):
        return self._subject
    def set_subject(self, subject):
        self._subject = subject

    
    def is_old(self):
        return self.get_age() > 10

    def count_pages_per_year(self):
        age = self.get_age()
        return (self._pages / age) * 2 if age > 0 else self._pages

    def get_edition_info(self):
        return "Учебник по предмету '{self._subject}', издан в {self._year} году."
